+/* Restores what the capture suspended and hands its pixels over; ones the canvas does not take go on
+ * screen as they would have, through the restored clips, alpha and blend mode. */
+static void capture_end(NRCtx* ctx)
+{
+    ctx->scratch_buf = ctx->saved_scratch_buf;
+    ctx->scratch_w = ctx->saved_scratch_w;
+    ctx->scratch_h = ctx->saved_scratch_h;
+    ctx->scratch_ox = ctx->saved_scratch_ox;
+    ctx->scratch_oy = ctx->saved_scratch_oy;
+    ctx->mask_floor = ctx->saved_mask_floor;
+    ctx->draw_alpha = ctx->saved_alpha;
+    ctx->blend_mode = ctx->saved_blend;
+    const int depth = ctx->capture_depth;
+    ctx->capture_depth = -1;
+    if (ctx->written_x0 >= ctx->written_x1)
+        return;
+    const int stride = ctx->capture_w;
+    uint32_t* const first =
+        ctx->capture_buf + (size_t)(ctx->written_y0 - ctx->capture_y) * (size_t)stride + (ctx->written_x0 - ctx->capture_x);
+    ERCanvasOp op = {0};
+    op.kind = ER_CANVAS_PIXELS;
+    op.depth = (uint8_t)depth;
+    op.buffer = first;
+    op.width = stride;
+    op.x = ctx->written_x0;
+    op.y = ctx->written_y0;
+    op.w = ctx->written_x1 - ctx->written_x0;
+    op.h = ctx->written_y1 - ctx->written_y0;
+    if (g_er_canvas(&op, s_canvas_ctx) != ER_CANVAS_TAKEN)
+    {
+        ctx->canvas_depth++;
+        er_blit_blend(first, stride * (int)sizeof(uint32_t), 255U, op.x, op.y, op.w, op.h);
+        ctx->canvas_depth--;
+    }
+    for (int row = 0; row < op.h; row++)
+        memset(first + (size_t)row * (size_t)stride, 0, (size_t)op.w * sizeof(uint32_t));
+}
+
+bool er_canvas_offer(ERCanvasOp* op)
+{
+    NRCtx* const ctx = rc();
+    op->depth = ctx->canvas_depth;
+    const int answer = g_er_canvas(op, s_canvas_ctx);
+    if (answer == ER_CANVAS_TAKEN)
+        return true;
+    /* One capture at a time: what a captured op draws inside it is part of its pixels. */
+    if (answer == ER_CANVAS_CAPTURE && ctx->capture_depth < 0 && op->bounds[2] > 0 && op->bounds[3] > 0
+        && !capture_begin(ctx, op->bounds))
+        return true; /* nothing of it is visible */
+    ctx->canvas_depth++;
+    return false;
+}
+
+void er_canvas_done(void)
+{
+    NRCtx* const ctx = rc();
+    ctx->canvas_depth--;
+    if (ctx->capture_depth >= 0 && ctx->capture_depth == ctx->canvas_depth)
+        capture_end(ctx);
+}
+
+void er_canvas_note(ERCanvasOp* op)
+{
+    op->depth = rc()->canvas_depth;
+    (void)g_er_canvas(op, s_canvas_ctx);
+}
