+/* Starts drawing into the capture buffer: the op's bounds, cut to the clip rect, unmasked, at full alpha
+ * and in normal blending. False when none of it is visible. */
+static bool capture_begin(NRCtx* ctx, const int bounds[4])
+{
+    int x = bounds[0], y = bounds[1], w = bounds[2], h = bounds[3];
+    if (!apply_clip(ctx, &x, &y, &w, &h))
+        return false;
+    const size_t need = (size_t)w * (size_t)h;
+    if (need > ctx->capture_cap)
+    {
+        uint32_t* grown = (uint32_t*)calloc(need, sizeof(uint32_t));
+        if (!grown)
+            return false;
+        free(ctx->capture_buf);
+        ctx->capture_buf = grown;
+        ctx->capture_cap = need;
+    }
