+#ifndef EMBEDDED_REACT_ER_CANVAS_H
+#define EMBEDDED_REACT_ER_CANVAS_H
+
+#include "er_scene.h"
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C"
+{
+#endif
+
+    /*
+     * A canvas sees every drawing primitive before the software rasterizer does. With none installed
+     * (the default) nothing changes: each primitive draws as it always has. An installed canvas gets
+     * one ERCanvasOp per primitive call and answers whether it took it: true skips the software
+     * drawing, false lets it run. A canvas that records and answers false traces the frame; one that
+     * draws the ops itself (on a GPU) answers true.
+     *
+     * Primitives call one another (a bordered rounded rect fills two rounded rects, a text run blends
+     * its glyphs): `depth` counts the primitives the op is nested in, so a canvas that takes the outer
+     * op never sees the inner ones, and one that passes on the outer op sees its parts at depth 1+.
+     * Blits that reach the framebuffer at depth 0 come from no primitive: ER_CANVAS_FILL is a plain
+     * rectangle fill, ER_CANVAS_UNHOOKED any other pixels the canvas has not been shown.
+     *
+     * Ops arrive on the thread that draws them; with several render workers they interleave. A canvas
+     * that needs one ordered stream runs the engine with a single worker. Pointers in an op are valid
+     * for the call only.
+     */
+
+    typedef enum
+    {
+        /* Shapes */
+        ER_CANVAS_FILL = 0,         /**< Plain rectangle fill: argb, rect. */
+        ER_CANVAS_RRECT,            /**< Rounded rect fill: argb, rect, radii[4] (tl, tr, br, bl). */
+        ER_CANVAS_RRECT_BORDERED,   /**< Rounded rect with a uniform border: argb, argb2 (border), width, radii[0]. */
+        ER_CANVAS_RRECT_RING,       /**< Rounded ring of width `width`: argb, radii[4]. */
+        ER_CANVAS_RRECT_RING_EDGES, /**< Ring with per-edge widths and colors: radii[4], border. */
+        ER_CANVAS_GRADIENT,         /**< A view's background gradient: view, rect. */
+        ER_CANVAS_SHADOW,           /**< A view's drop shadow: view, rect (the view's box, not the bleed). */
+        ER_CANVAS_BORDER_SWEEP,     /**< Animated focus ring: argb, width, radii[0], f[0] phase, f[1] length. */
+        ER_CANVAS_BORDER_CONIC,     /**< Conic gradient ring: width, radii[0], f[0] from, stops. */
+        ER_CANVAS_BORDER_RADIAL,    /**< Radial gradient ring: width, radii[0], f[0] size, f[1] angle, stops. */
+        ER_CANVAS_ARC_SECTOR,       /**< Arc sector: arc. */
+        ER_CANVAS_VECTOR,           /**< Vector path ops (SVG): rect = clip, x/y in pos[]; vector fields. */
+        ER_CANVAS_VECTOR_SLOT,      /**< Cached vector slot: slot, pos[], rect = clip. */
+        /* Content */
+        ER_CANVAS_TEXT,  /**< A text block, laid out by the engine: text. */
+        ER_CANVAS_IMAGE, /**< An image in its box: image, rect. */
+        ER_CANVAS_CLEAR, /**< Transparent hole (a host layer shows through): rect. */
+        /* State */
+        ER_CANVAS_CLIP_RECT,  /**< Push a rectangular clip: rect. */
+        ER_CANVAS_CLIP_RRECT, /**< Push a rounded clip: rect, radii[4]. */
+        ER_CANVAS_CLIP_RESET, /**< Push a full-screen clip that hides the ones below. */
+        ER_CANVAS_CLIP_POP,   /**< Pop the last clip. */
+        ER_CANVAS_ALPHA,      /**< Draw alpha multiplied into what follows: alpha. */
+        ER_CANVAS_BLEND,      /**< Blend mode for what follows: mode. */
+        /* Groups: a subtree drawn offscreen, then put on screen */
+        ER_CANVAS_GROUP_BEGIN, /**< Draw into buffer `buffer`, rect = its screen area. */
+        ER_CANVAS_GROUP_END,   /**< Back to the screen. */
+        ER_CANVAS_GROUP_DRAW,  /**< Put group `buffer` on screen at rect, at alpha. */
+        ER_CANVAS_GROUP_XFORM, /**< Put the transform source on screen through matrix m[] (2D: a b c d tx ty, the inverse). */
+        /* Diagnostics */
+        ER_CANVAS_UNHOOKED, /**< Pixels reaching the screen outside any primitive: rect. */
+        ER_CANVAS_MOVE,     /**< A scroll copy of screen pixels: rect = source, pos[] = destination. */
+        ER_CANVAS_OP_COUNT
+    } ERCanvasOpKind;
+
+    typedef struct ERCanvasOp
+    {
+        uint8_t kind;  /**< ERCanvasOpKind */
+        uint8_t depth; /**< Primitives this op is nested in; 0 = called by the compositor. */
+        uint8_t alpha;
+        uint8_t mode;
+        int x, y, w, h;  /**< The op's rectangle (screen space). */
+        int radii[4];    /**< tl, tr, br, bl */
+        int width;       /**< Border or ring width. */
+        uint32_t argb;   /**< Straight-alpha ARGB8888. */
+        uint32_t argb2;  /**< Second color (a bordered rect's border). */
+        int pos[2];      /**< A second point (vector origin, move destination). */
+        float f[2];      /**< Two scalars the kind defines. */
+        float m[9];      /**< A transform (ER_CANVAS_GROUP_XFORM). */
+        int slot;        /**< Vector cache slot. */
+        int stop_count;  /**< Stops behind `stops`. */
+        const void* buffer; /**< The group's scratch buffer: identifies a group across BEGIN, END and DRAW. */
+        const ERGradientStop* stops;
+        /* Engine-internal structs, by the kinds that carry them. */
+        const void* view;   /**< ERViewProps */
+        const void* image;  /**< ERImageProps */
+        const void* text;   /**< ERTextRenderParams */
+        const void* border; /**< ERRRectBorder */
+        const void* arc;    /**< ERArcSector */
+    } ERCanvasOp;
+
+    /** @brief Answers whether the canvas took the op (true: the software drawing is skipped). */
+    typedef bool (*ERCanvasFn)(const ERCanvasOp* op, void* ctx);
+
+    /** @brief Installs a canvas, or removes it with NULL. Call between commits. */
+    void er_set_canvas(ERCanvasFn fn, void* ctx);
+
+    /** @brief The installed canvas function, or NULL. */
+    ERCanvasFn er_get_canvas(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* EMBEDDED_REACT_ER_CANVAS_H */
