+        /* Parts of an image (depth 1 under ER_CANVAS_IMAGE) */
+        ER_CANVAS_IMAGE_REGION, /**< Image pixels scaled from src[] to rect: buffer = the pixels (mode = ERImageFormat,
+                                     slot x width = their size, name), argb = tint (f[0] = 1 when tinted),
+                                     area = the box a rounded image is cut to, radii[4] its corners. */
+        /* Pixels */
+        ER_CANVAS_PIXELS, /**< A captured op's pixels: buffer = premultiplied ARGB8888 rows of `width` pixels, rect = the box it drew in. */
+        ER_CANVAS_OP_COUNT
+    } ERCanvasOpKind;
+
+    typedef struct ERCanvasOp
+    {
+        uint8_t kind;  /**< ERCanvasOpKind */
+        uint8_t depth; /**< Primitives this op is nested in; 0 = called by the compositor. */
+        uint8_t alpha;
+        uint8_t mode;  /**< Blend mode (ER_CANVAS_BLEND), border style (ring edges: 0 solid, 1 dashed, 2 dotted). */
+        int x, y, w, h;  /**< The op's rectangle (screen space). */
+        int radii[4];    /**< tl, tr, br, bl */
+        int width;       /**< Border or ring width. */
+        int edges[4];    /**< Per-edge widths: left, top, right, bottom. */
+        uint32_t edge_colors[4]; /**< Per-edge colors, same order, straight-alpha ARGB8888. */
+        uint32_t argb;   /**< Straight-alpha ARGB8888. */
+        uint32_t argb2;  /**< Second color (a bordered rect's border). */
+        int pos[2];      /**< A second point (vector origin, move destination). */
+        int area[4];     /**< A second rectangle (a glyph's clip): x, y, w, h. */
+        int src[4];      /**< A source rectangle (an image region's): x, y, w, h. */
+        int bounds[4];   /**< Every pixel the op can touch: x, y, w, h; w = 0 when not known (no capture). */
+        const char* name; /**< An image's registry name. */
+        float f[2];      /**< Two scalars the kind defines. */
+        float m[9];      /**< A transform (ER_CANVAS_GROUP_XFORM). */
+        int slot;        /**< Vector cache slot. */
+        int stop_count;  /**< Stops behind `stops`. */
+        const void* buffer; /**< The group's scratch buffer: identifies a group across BEGIN, END and DRAW. */
+        const void* source; /**< Another group (ER_CANVAS_GROUP_KEEP). */
+        const ERGradientStop* stops;
+        /* Engine-internal structs, by the kinds that carry them. */
+        const void* view;   /**< ERViewProps */
+        const void* image;  /**< ERImageProps */
+        const void* text;   /**< ERTextRenderParams */
+        const void* arc;    /**< ERArcSector */
+    } ERCanvasOp;
+
+    typedef enum
+    {
+        ER_CANVAS_PASS = 0,    /**< The software drawing runs. */
+        ER_CANVAS_TAKEN = 1,   /**< The canvas drew it; the software drawing is skipped. */
+        ER_CANVAS_CAPTURE = 2, /**< Draw it into a buffer and hand over the pixels (ops with bounds only). */
+    } ERCanvasAnswer;
+
+    /** @brief The canvas's answer to an op (ERCanvasAnswer). */
+    typedef int (*ERCanvasFn)(const ERCanvasOp* op, void* ctx);
+
+    /** @brief Installs a canvas, or removes it with NULL. Call between commits. */
+    void er_set_canvas(ERCanvasFn fn, void* ctx);
+
+    /** @brief The installed canvas function, or NULL. */
+    ERCanvasFn er_get_canvas(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* EMBEDDED_REACT_ER_CANVAS_H */
