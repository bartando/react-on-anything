+/* A blit that reaches the screen at depth 0 comes from no primitive: offer it as what it is. True when the
+ * canvas took it. Otherwise the blit runs one level down, so the blits it makes of its own stay quiet. */
+static bool canvas_raw_blit(NRCtx* ctx, uint8_t kind, const void* src, int stride, uint8_t alpha, int x, int y, int w, int h)
+{
+    if (ctx->canvas_depth > 0)
+        return false;
+    ERCanvasOp op = {0};
+    op.kind = kind;
+    op.alpha = alpha;
+    op.x = x;
+    op.y = y;
+    op.w = w;
+    op.h = h;
+    const uint8_t* s = (const uint8_t*)src;
+    if (kind != ER_CANVAS_FILL && s && ctx->canvas_group && s >= ctx->canvas_group
+        && s < ctx->canvas_group + ctx->canvas_group_bytes)
+    {
+        op.kind = ER_CANVAS_GROUP_DRAW;
+        op.buffer = ctx->canvas_group;
+        /* Where in the group's buffer the drawn rows start (its stride is the group's width). */
+        const size_t at = (size_t)(s - ctx->canvas_group);
+        if (stride > 0)
+        {
+            op.pos[0] = (int)((at % (size_t)stride) / 4U);
+            op.pos[1] = (int)(at / (size_t)stride);
+        }
+        op.width = stride / 4;
+    }
+    return er_canvas_offer(&op);
+}
