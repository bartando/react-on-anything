+        /* Diagnostics */
+        ER_CANVAS_UNHOOKED, /**< Pixels reaching the screen outside any primitive: rect. */
+        ER_CANVAS_MOVE,     /**< A scroll copy of screen pixels: rect = source, pos[] = destination. */
+        /* Parts of a text block (depth 1 under ER_CANVAS_TEXT) */
+        ER_CANVAS_GLYPH, /**< A baked glyph: buffer = its bitmap, rect = where it lands, mode = bits per pixel
