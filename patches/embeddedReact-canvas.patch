+        return;
+    const int x0 = x > ctx->capture_x ? x : ctx->capture_x;
+    const int y0 = y > ctx->capture_y ? y : ctx->capture_y;
+    const int x1 = x + w < ctx->capture_x + ctx->capture_w ? x + w : ctx->capture_x + ctx->capture_w;
+    const int y1 = y + h < ctx->capture_y + ctx->capture_h ? y + h : ctx->capture_y + ctx->capture_h;
+    if (x0 >= x1 || y0 >= y1)
+        return;
+    if (ctx->written_x0 >= ctx->written_x1)
+    {
+        ctx->written_x0 = x0;
+        ctx->written_y0 = y0;
+        ctx->written_x1 = x1;
+        ctx->written_y1 = y1;
+        return;
